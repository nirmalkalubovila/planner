{
  "expo": {
    "name": "Legacy LB",
    "slug": "legacy-life-builder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-llb.png",
    "scheme": "legacylifebuilder",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.legacylifebuilder.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon-llb-adaptive-foreground.png",
        "monochromeImage": "./assets/images/icon-llb-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.legacylifebuilder"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/llb-logo-white.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Legacy Life Builder needs access to your photos to set a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#208AEF"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayMomentum",
              "label": "Today Momentum",
              "description": "Next task, what's after it, and today's progress.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-previews/today-momentum.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "WeekHeatmap",
              "label": "Week Heatmap",
              "description": "This week's completion heatmap and biggest win.",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-previews/week-heatmap.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MonthStreak",
              "label": "Month Streak",
              "description": "Current streak and this month's activity calendar.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widget-previews/month-streak.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba0b1985-c209-4b1c-b9c3-8a08851b2448"
      }
    }
  }
}
